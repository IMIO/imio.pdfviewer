graft src/imio
# The built bundle must ship in the sdist and in the wheel.
recursive-include src/imio/pdfviewer/browser/static *
# The bundle sources.
graft resources
graft webpack
include package.json package-lock.json *.config.js .prettierignore
graft news
graft tests
include *.md
include *.toml
include LICENSE.GPL
prune node_modules
global-exclude *.pyc
global-exclude __pycache__
global-exclude .DS_Store
