{
  "name": "@imio/pat-pdf-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "PDF viewer pattern for Plone 6 Classic UI",
  "license": "GPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IMIO/imio.pdfviewer.git"
  },
  "main": "resources/pat-pdf-viewer/pdf-viewer.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "NODE_ENV=production webpack --config webpack.config.js",
    "start": "NODE_ENV=development webpack serve --config webpack.config.js",
    "watch": "NODE_ENV=development webpack --config webpack.config.js --watch",
    "test": "jest",
    "lint": "eslint resources"
  },
  "dependencies": {
    "@mikecousins/react-pdf": "^8.1.2",
    "@patternslib/patternslib": "9.10.7",
    "@plone/mockup": "5.6.10",
    "pdfjs-dist": "^5",
    "print-js-updated": "^1.6.1",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@babel/preset-react": "^8.0.1",
    "@patternslib/dev": "^4.3.0",
    "bootstrap": "5.3.8"
  },
  "overrides": {
    "@patternslib/patternslib": "$@patternslib/patternslib",
    "jquery": "<4"
  },
  "keywords": [
    "patternslib",
    "mockup",
    "plone",
    "pdf"
  ]
}
